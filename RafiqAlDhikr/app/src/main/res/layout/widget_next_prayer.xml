<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
        android:fontFamily="@font/amiri_regular"
            android:id="@+id/np_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاة القادمة"
            android:textColor="#0E4D3A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
        android:fontFamily="@font/amiri_regular"
            android:id="@+id/np_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#0E4D3A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
        android:fontFamily="@font/amiri_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بعد "
            android:textColor="#2B2B2B"
            android:textSize="14sp" />

        <Chronometer
        android:fontFamily="@font/amiri_regular"
            android:id="@+id/np_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:textColor="#2B2B2B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
        android:fontFamily="@font/amiri_regular" android:id="@+id/np_fajr" android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:textSize="12sp" />
        <TextView
        android:fontFamily="@font/amiri_regular" android:id="@+id/np_dhuhr" android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:textSize="12sp" />
        <TextView
        android:fontFamily="@font/amiri_regular" android:id="@+id/np_asr" android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:textSize="12sp" />
        <TextView
        android:fontFamily="@font/amiri_regular" android:id="@+id/np_maghrib" android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:textSize="12sp" />
        <TextView
        android:fontFamily="@font/amiri_regular" android:id="@+id/np_isha" android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
